{
  "name": "sirad-web-app",
  "license": "MIT",
  "version": "0.0.1",
  "engines": {
    "node": "22.23.x",
    "npm": "10.9.x"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "prestart": "npm run build",
    "start": "ts-node --project ./tsconfig.node.json ./server/index.ts",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "ts-node-dev --project ./tsconfig.node.json ./server/index.ts",
    "clean": "rimraf ./dist",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier -c .",
    "format:fix": "prettier -w .",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axios": "1.21.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reset-css": "5.0.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/ui": "5.1.1",
    "concurrently": "10.0.7",
    "dotenv-cli": "11.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "gh-pages": "^6.3.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "ts-node-dev": "2.0.0",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
